{
  "name": "nasr-website",
  "version": "1.0.0",
  "description": "Personal academic website for Prof. Nasr El Din Ibrahim Ahmed Hussein",
  "main": "src/backend/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node src/backend/server.js",
    "dev:client": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "start": "node src/backend/server.js",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "phase3": "python scripts/apply_phase3.py",
    "upload:blob": "node scripts/upload-to-blob.mjs",
    "clear:blob": "node scripts/clear-blob.mjs",
    "deploy:prepare": "python scripts/apply_phase3.py && node scripts/upload-to-blob.mjs"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@vercel/blob": "^0.27.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "glightbox": "^3.3.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "concurrently": "^9.1.0",
    "mammoth": "^1.12.3",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0"
  }
}
